load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_registration",
    srcs = ["test_registration.py"],
    # The registry imports the ModuleV2 build by name, so pydeps sees it as
    # unused.
    ignore_extra_deps = ["//max/python/max/pipelines/architectures/qwen3_5"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/mtp_qwen3_5_modulev3",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/architectures/qwen3_5_modulev3",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
    ],
)

# Staging leaves the graph as text, so the cases need no accelerator tag and
# no kernel registration.
modular_py_test(
    name = "test_attention_segment_routing",
    srcs = ["test_attention_segment_routing.py"],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/nn:core",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/qwen3_5_modulev3",
    ],
)

# The readout gather runs on the CPU device and the operand gate reads a class
# attribute, so these cases need no accelerator tag and load no checkpoint.
modular_py_test(
    name = "test_label_logits_readout",
    srcs = ["test_label_logits_readout.py"],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/qwen3_5_modulev3",
        "//max/python/max/pipelines/lib",
        requirement("numpy"),
    ],
)
